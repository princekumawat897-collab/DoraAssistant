<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dora AI Agent"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/permBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Accessibility Permission चालू करें"
        android:layout_marginBottom="15dp"/>

    <EditText
        android:id="@+id/commandInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="कमांड लिखें (उदा: click Login या Login दबाओ)"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/executeBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="कमांड रन करें"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/voiceBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎤 बोलकर कमांड दें"
        android:layout_marginBottom="25dp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Ready"
        android:textSize="16sp"/>
</LinearLayout>
